  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Forest action with white text, soft depth, and a small hover lift.",
      "html": "<a class=\"ds-button ds-primary\" href=\"#connect\">Let’s connect<svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 7h10v10M7 17 17 7\"/></svg></a>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:50px;padding:14px 21px;border:0;border-radius:50px;font-family:Manrope,sans-serif;font-size:12px;font-weight:700;text-decoration:none;cursor:pointer;transition:transform .35s var(--ease,cubic-bezier(.16,1,.3,1)),box-shadow .35s var(--ease,cubic-bezier(.16,1,.3,1)),background .3s}.ds-button:hover{transform:translateY(-3px);box-shadow:0 3px 5px #263e3010,0 12px 20px #263e3015;background:#fff}.ds-button:focus-visible{outline:2px solid #3c7452;outline-offset:5px}@media(prefers-reduced-motion:reduce){.ds-button{animation:none!important;transition:none!important}}.ds-primary{background:var(--accent,#245440);color:#fff;box-shadow:0 2px 4px #16362520,0 9px 17px #2e503524}.ds-primary:hover{background:#193e2f}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Raised white companion action for exploration or a resume.",
      "html": "<a class=\"ds-button ds-secondary\" href=\"#projects\"><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m6 14 1.5-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.54 6A2 2 0 0 1 18.46 20H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2A2 2 0 0 0 12.1 7H20a2 2 0 0 1 2 2v2\"/></svg>Explore projects</a>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:50px;padding:14px 21px;border:0;border-radius:50px;font-family:Manrope,sans-serif;font-size:12px;font-weight:700;text-decoration:none;cursor:pointer;transition:transform .35s var(--ease,cubic-bezier(.16,1,.3,1)),box-shadow .35s var(--ease,cubic-bezier(.16,1,.3,1)),background .3s}.ds-button:hover{transform:translateY(-3px);box-shadow:0 3px 5px #263e3010,0 12px 20px #263e3015;background:#fff}.ds-button:focus-visible{outline:2px solid #3c7452;outline-offset:5px}@media(prefers-reduced-motion:reduce){.ds-button{animation:none!important;transition:none!important}}.ds-secondary{background:#fff;color:var(--ink,#29483d);box-shadow:var(--shadow,0 2px 3px #263e3010,0 9px 15px #263e300c,0 22px 24px #263e3005)}"
    },
    {
      "name": "Raised Icon Button",
      "kind": "button",
      "refersTo": "icon-button-raised",
      "description": "Compact circular utility control with an accessible name.",
      "html": "<button class=\"ds-icon-button\" type=\"button\" aria-label=\"Replay showcase animation\"><svg viewBox=\"0 0 24 24\" width=\"15\" height=\"15\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 10a9 9 0 1 1 2 8M3 4v6h6\"/></svg></button>",
      "css": ".ds-icon-button{width:37px;height:37px;display:inline-flex;align-items:center;justify-content:center;border:0;border-radius:50%;background:#fff;color:var(--ink,#29483d);box-shadow:var(--shadow,0 2px 3px #263e3010,0 9px 15px #263e300c,0 22px 24px #263e3005);cursor:pointer;transition:background .2s,transform .3s var(--ease,cubic-bezier(.16,1,.3,1))}.ds-icon-button:hover{background:#e3e8df;transform:translateY(-2px)}.ds-icon-button:focus-visible{outline:2px solid #3c7452;outline-offset:5px}@media(prefers-reduced-motion:reduce){.ds-icon-button{animation:none!important;transition:none!important}}"
    },
    {
      "name": "Sidebar Navigation",
      "kind": "nav",
      "refersTo": "navigation-item",
      "description": "Icon-and-label navigation; selection is a raised paper pill with a trailing arrow.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Main navigation\"><a class=\"ds-nav-link ds-nav-active\" href=\"#home\" aria-current=\"page\"><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m3 10 9-7 9 7v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"/><path d=\"M9 21v-8h6v8\"/></svg><span>Home</span><span class=\"ds-nav-arrow\"><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></span></a><a class=\"ds-nav-link\" href=\"#projects\"><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m6 14 1.5-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.54 6A2 2 0 0 1 18.46 20H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2A2 2 0 0 0 12.1 7H20a2 2 0 0 1 2 2v2\"/></svg><span>Projects</span><span class=\"ds-nav-arrow\"><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></span></a></nav>",
      "css": ".ds-nav{display:flex;flex-direction:column;gap:7px;font-family:Manrope,sans-serif}.ds-nav-link{display:flex;align-items:center;gap:12px;min-height:53px;padding:15px 20px;border-radius:28px;font-size:14px;font-weight:650;color:var(--muted,#5e6e58);text-decoration:none;white-space:nowrap;transition:background .25s,color .25s,box-shadow .3s}.ds-nav-link:hover{color:var(--ink,#29483d);background:#e7eae3}.ds-nav-active{background:#fafbf7;color:var(--ink,#29483d);box-shadow:var(--shadow,0 2px 3px #263e3010,0 9px 15px #263e300c,0 22px 24px #263e3005)}.ds-nav-active>svg:first-child{fill:#29483d12}.ds-nav-arrow{margin-left:auto;opacity:0;color:#83957f;transition:opacity .2s,transform .2s}.ds-nav-active .ds-nav-arrow{opacity:1}.ds-nav-link:hover .ds-nav-arrow{opacity:1;transform:translateX(2px)}.ds-nav-link:focus-visible{outline:2px solid #3c7452;outline-offset:5px}@media(prefers-reduced-motion:reduce){.ds-nav-link,.ds-nav-arrow{animation:none!important;transition:none!important}}"
    },
    {
      "name": "Project Filter",
      "kind": "chip",
      "refersTo": "filter-chip",
      "description": "Category buttons with counts and an elevated selected state.",
      "html": "<div class=\"ds-filters\" role=\"group\" aria-label=\"Filter projects\"><button class=\"ds-filter ds-filter-selected\" type=\"button\" aria-pressed=\"true\">All work<span>7</span></button><button class=\"ds-filter\" type=\"button\" aria-pressed=\"false\">Design</button></div>",
      "css": ".ds-filters{display:flex;gap:7px;flex-wrap:wrap}.ds-filter{display:flex;align-items:center;gap:10px;min-height:43px;padding:12px 17px;border:0;border-radius:30px;background:transparent;color:var(--muted,#5e6e58);font-family:Manrope,sans-serif;font-size:11px;font-weight:600;cursor:pointer;transition:background .3s,box-shadow .3s,color .3s}.ds-filter>span{font-size:8px;min-width:14px;color:var(--muted,#5e6e58)}.ds-filter:hover{color:#3f5f34;background:#eaf0e2}.ds-filter-selected{background:#fff;color:#3a5931;box-shadow:var(--shadow,0 2px 3px #263e3010,0 9px 15px #263e300c,0 22px 24px #263e3005)}.ds-filter:focus-visible{outline:2px solid #3c7452;outline-offset:5px}@media(prefers-reduced-motion:reduce){.ds-filter{animation:none!important;transition:none!important}}"
    },
    {
      "name": "Skill Chip",
      "kind": "chip",
      "refersTo": "skill-chip",
      "description": "Static skill metadata with a quiet tinted background and small corners.",
      "html": "<span class=\"ds-skill-chip\">Product design</span>",
      "css": ".ds-skill-chip{display:inline-block;padding:6px 10px;border-radius:6px;background:#edf0e7;color:var(--muted,#5e6e58);font-family:Manrope,sans-serif;font-size:10px;font-weight:450;line-height:1.4}"
    },
    {
      "name": "Experience Card",
      "kind": "card",
      "refersTo": "experience-card",
      "description": "An ambient white card with a rotated company mark and factual role.",
      "html": "<article class=\"ds-experience\"><div class=\"ds-company-mark\" aria-hidden=\"true\">jc<span>.</span></div><div><h3>Jarurat Care Foundation</h3><p>UI/UX Design Intern</p></div></article>",
      "css": ".ds-experience{display:flex;gap:24px;padding:30px;border-radius:19px;background:#fff;color:var(--ink,#29483d);box-shadow:0 2px 4px #3c513307,0 10px 23px #3c51330a;font-family:Manrope,sans-serif}.ds-company-mark{display:flex;align-items:center;justify-content:center;flex-shrink:0;width:61px;height:66px;border-radius:15px;transform:rotate(-6deg);background:#e4edd8;color:#6e8755;font-size:27px;font-weight:700;letter-spacing:-.07em}.ds-experience h3{margin:0;font-size:17px;font-weight:650;letter-spacing:-.02em}.ds-experience p{margin:5px 0 0;color:var(--muted,#5e6e58);font-size:11px;font-weight:450;line-height:1.8}@media(max-width:760px){.ds-experience{flex-direction:column;gap:15px;padding:23px 20px;border-radius:17px}.ds-company-mark{width:47px;height:50px;border-radius:13px;font-size:22px}.ds-experience h3{font-size:15px}}@media(min-width:500px) and (max-width:760px){.ds-experience{flex-direction:row}}"
    },
    {
      "name": "Type Size Range",
      "kind": "input",
      "refersTo": "type-range",
      "description": "Native range control used by the bounded typography study, from 24 to 48 in steps of 4.",
      "html": "<label class=\"ds-type-slider\"><input aria-label=\"Type size\" type=\"range\" min=\"24\" max=\"48\" step=\"4\" value=\"32\"/></label>",
      "css": ".ds-type-slider{display:flex;align-items:center;width:90%;height:13px}.ds-type-slider input{width:100%;height:3px;accent-color:#8c856e;caret-color:var(--accent,#245440);cursor:ew-resize}.ds-type-slider input:hover{cursor:ew-resize}.ds-type-slider input:focus-visible{outline:2px solid #3c7452;outline-offset:5px}"
    },
    {
      "name": "Inline Code Tile",
      "kind": "custom",
      "refersTo": "inline-code-tile",
      "description": "The decorative code object inside the hero headline responds to heading hover.",
      "html": "<h1 class=\"ds-code-context\">Purpose in <span class=\"ds-code-tile\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" width=\"30\" height=\"30\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m18 16 4-4-4-4M6 8l-4 4 4 4M14.5 4l-5 16\"/></svg></span> code.</h1>",
      "css": ".ds-code-context{margin:0;color:var(--ink,#29483d);font-family:Manrope,sans-serif;font-size:clamp(40px,4.1vw,58px);font-weight:650;line-height:1.24;letter-spacing:-.04em}.ds-code-tile{display:inline-flex;align-items:center;justify-content:center;vertical-align:baseline;width:49px;height:48px;margin:0 2px;border-radius:13px;background:#d6e5c7;color:#486d35;box-shadow:inset 0 2px 3px #ffffff80,0 4px 6px #31522912;transform:rotate(-9deg) translateY(-2px);transition:transform .5s var(--ease,cubic-bezier(.16,1,.3,1))}.ds-code-context:hover .ds-code-tile{transform:rotate(5deg) translateY(-5px)}@media(prefers-reduced-motion:reduce){.ds-code-tile{animation:none!important;transition:none!important}}"
    }
  ],
  "narrative": {
    "northStar": "Personal Studio",
    "overview": "A personal studio in forest green, sage, and warm white. The user's pinned Kree8 reference establishes the fixed navigation rail, rounded scrolling sheet, narrow editorial copy, wider project showcases, and tactile controls. Manrope, crisp outline icons, restrained rotations, and soft layered shadows give the interface a thoughtful, approachable character.\n\nThe work changes scale between reading and looking: quiet text sits beside generous code-drawn interface compositions. Project art is original illustrative UI, with that status disclosed on detail pages; there are no shipping raster images. Motion is a brief entrance or a direct response to an action. Small section labels and pill controls are native to this chosen reference and retain their specific orientation and action roles.",
    "keyCharacteristics": [
      "Forest text and controls over warm paper and pale sage fields.",
      "A persistent desktop rail with alternating editorial and showcase widths.",
      "Manrope hierarchy, open paragraph leading, and tightly spaced display type.",
      "Softly raised pills, clipped project panels, and gently rotated code objects.",
      "Finite entrances, manual project navigation, and three bounded playground studies."
    ],
    "rules": [
      {
        "name": "The Reading Contrast Rule",
        "body": "Use the final muted and soft-ink values for secondary reading text. Pale sage surfaces and decorative headline emphasis do not replace readable body colors.",
        "section": "colors"
      },
      {
        "name": "The One Family Rule",
        "body": "Keep Manrope across display, reading, and controls. Preserve the isolated italic sign-off as a signature rather than extending it into a competing heading system.",
        "section": "typography"
      },
      {
        "name": "The Tactile Control Rule",
        "body": "Reserve the recurring raised white treatment for controls and selected states; use the quieter sheet and card shadows for content surfaces.",
        "section": "elevation & depth"
      },
      {
        "name": "The Motion at Your Pace Rule",
        "body": "Entrances finish, project switching stays manual, and playground motion begins on request. Under `prefers-reduced-motion: reduce`, animations, transitions, and smooth scrolling are disabled while the static layered composition and every control remain usable.",
        "section": "components"
      }
    ],
    "dos": [
      "Do preserve the rail, rounded sheet, and alternating editorial/showcase widths established by the pinned reference.",
      "Do use the final contrast-adjusted reading colors and final single-column project gallery.",
      "Do retain native small section labels for orientation and tactile pills for actions and selected states.",
      "Do preserve truthful visual provenance: label illustrative UI, and use actual project captures when available.",
      "Do preserve keyboard focus, named icon controls, mobile drawer behavior, and reduced-motion support.",
      "Do make motion finite and let visitors control project changes and playground replay."
    ],
    "donts": [
      "Don't turn every content row into a raised card or replace the narrow/wide composition with a repeated uniform grid.",
      "Don't promote pale illustrative text colors or tiny decorative captions into body-text defaults.",
      "Don't extend a local project illustration palette or the isolated italic signature into a new global visual system.",
      "Don't add an auto-advancing carousel, infinite playground, autoplay video, or continuously repeating experiment animation.",
      "Don't present illustrative UI as supplied screenshots or add invented metrics, testimonials, or agency proof as visual content."
    ]
  }
}
